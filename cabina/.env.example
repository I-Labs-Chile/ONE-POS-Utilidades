# Configuración de la Cabina Fotográfica
# Copia este archivo a .env y ajusta lo necesario:  cp .env.example .env

# Puerto HTTP del kiosco (distinto del servidor web para convivir)
SERVER_PORT=8081

# Directorio de datos propio de la cabina
QUEUE_DIR=./data-cabina

# Ancho de papel en píxeles: 384 = 58mm, 576 = 80mm
PAPER_WIDTH_PX=384

# DPI de rasterización (la cabina imprime imágenes, casi no afecta)
RASTER_DPI=203

# URL del QR que acompaña a la tira impresa
CABINA_QR_URL=https://www.instagram.com/ilabs.cl/

# Interfaz de impresora: usb | tcp (igual que el servidor)
PRINTER_IF=usb
# PRINTER_HOST=192.168.1.100
# PRINTER_PORT=9100
# USB_VENDOR=0x04b8
# USB_PRODUCT=0x0202
# PRINTER_NAME=POS-58   # Windows: solo si la autodetección falla
