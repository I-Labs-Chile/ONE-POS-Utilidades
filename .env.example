# Configuración del servidor de impresión ESC/POS
# Copia este archivo a .env y ajusta lo necesario:  cp .env.example .env

# Interfaz de la impresora: usb | tcp
PRINTER_IF=usb

# Solo para PRINTER_IF=tcp
# PRINTER_HOST=192.168.1.100
# PRINTER_PORT=9100

# USB específica (autodetección si se omiten)
# USB_VENDOR=0x04b8
# USB_PRODUCT=0x0202

# Windows: nombre de la impresora según el spooler.
# Si se omite se autodetecta buscando nombres tipo "POS-58", "POS-80",
# "thermal", etc. Útil si el driver quedó instalado como "POS-58 (Copia 1)".
# PRINTER_NAME=POS-58

# Ancho de papel en píxeles: 384 = 58mm, 576 = 80mm
PAPER_WIDTH_PX=384

# DPI de rasterización de PDFs (típico: 203)
RASTER_DPI=203

# Puerto HTTP del servidor
SERVER_PORT=8080

# Directorio de datos (cola persistente y trabajos temporales)
QUEUE_DIR=./data

# Forzar backend de impresión (solo desarrollo): windows | linux
# PRINTER_BACKEND=
